// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LANDLORD
  TENANT
  CONTRIBUTOR
}

enum ListingType {
  RENT
  SALE
}

enum ListingStatus {
  ACTIVE
  RENTED
  SOLD
  WITHDRAWN
}

enum ProspectSource {
  PUBLIC_FORM
  MANUAL
}

enum PipelineStage {
  INQUIRY
  VIEWING_SCHEDULED
  VIEWED
  DISCUSSION
  BACKGROUND_CHECK
  OUTCOME_RENTED
  OUTCOME_SOLD
  OUTCOME_DROPPED
}

enum LeaseStatus {
  ACTIVE
  RENEWED
  EXPIRED
  VACATED
}

enum ProfessionalRole {
  AGENT
  CPA
  LAWYER
  PROPERTY_INSPECTOR
  PROPERTY_MANAGER
  MAINTENANCE_TEAM
  POLICE_VERIFICATION_AGENT
  OTHER
}

enum TaskType {
  LEASE_DRAFTING
  LEASE_SIGNING
  TENANT_POLICE_VERIFICATION
  ADVANCE_PAYMENT
  DEPOSIT_PAYMENT
  KEY_HANDOVER
  PROPERTY_INSPECTION
  RENT_COLLECTION
  TDS_FILING
  INDIA_TAX_FILING
  US_TAX_FILING
  PROPERTY_TAX_PAYMENT
  MAINTENANCE_PAYMENT
  LEASE_RENEWAL_DECISION
  VACATE_NOTICE
  OTHER
}

enum TaskRecurrence {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

model AllowedTester {
  email     String   @id
  role      Role     @default(LANDLORD)
  note      String?
  createdAt DateTime @default(now())

  @@map("allowed_testers")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(LANDLORD)

  accounts Account[]
  sessions Session[]

  ownedProperties Property[]      @relation("OwnerProperties")
  pipelineEvents  PipelineEvent[] @relation("EventAuthor")
  professionalAssignmentsMade PropertyProfessional[] @relation("AssignedByAdmin")
  notesWritten    Note[]          @relation("NoteAuthor")

  createdAt DateTime @default(now())

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Property {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String        @db.Text
  listingType ListingType
  status      ListingStatus @default(ACTIVE)

  addressLine String?
  city        String        @default("Chennai")
  state       String        @default("Tamil Nadu")
  pincode     String?

  priceInInr  Int?

  photos                  Photo[]
  prospects               Prospect[]
  leases                  Lease[]
  professionalAssignments PropertyProfessional[]
  notes                   Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("properties")
}

model Photo {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  @@map("photos")
}

model Prospect {
  id         String         @id @default(cuid())
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name       String
  contact    String
  notes      String?        @db.Text
  source     ProspectSource @default(PUBLIC_FORM)

  events     PipelineEvent[]
  leases     Lease[]

  createdAt  DateTime @default(now())

  @@map("prospects")
}

model PipelineEvent {
  id         String        @id @default(cuid())
  prospectId String
  prospect   Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  stage      PipelineStage
  notes      String?       @db.Text
  photoUrl   String?

  authorId   String
  author     User          @relation("EventAuthor", fields: [authorId], references: [id])

  createdAt  DateTime @default(now())

  @@map("pipeline_events")
}

model Professional {
  id    String           @id @default(cuid())
  name  String
  role  ProfessionalRole
  email String           @unique

  contact       String?
  licenseNumber String?
  notes         String?          @db.Text

  tasks       Task[]
  assignments PropertyProfessional[]

  createdAt DateTime @default(now())

  @@map("professionals")
}

model PropertyProfessional {
  id             String       @id @default(cuid())
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  assignedByUserId String
  assignedByUser   User   @relation("AssignedByAdmin", fields: [assignedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([propertyId, professionalId])
  @@map("property_professionals")
}

model Lease {
  id         String      @id @default(cuid())
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  prospectId String?
  prospect   Prospect?   @relation(fields: [prospectId], references: [id])

  tenantName    String
  tenantContact String
  tenantEmail   String

  startDate DateTime
  endDate   DateTime

  rentInInr    Int
  depositInInr Int

  status LeaseStatus @default(ACTIVE)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leases")
}

model Task {
  id      String @id @default(cuid())
  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  type       TaskType
  title      String?
  recurrence TaskRecurrence @default(ONE_TIME)
  status     TaskStatus     @default(PENDING)

  dueDate DateTime

  assignedProfessionalId String?
  assignedProfessional   Professional? @relation(fields: [assignedProfessionalId], references: [id])

  completedDate    DateTime?
  completedByName  String?
  proofDocumentUrl String?
  notes            String?   @db.Text

  createdAt DateTime @default(now())

  @@map("tasks")
}

// Internal, team-only notes on a property -- Admin and assigned
// Contributors only. Never shown to the Landlord or Tenant.
model Note {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id])

  body String @db.Text

  createdAt DateTime @default(now())

  @@map("notes")
}
