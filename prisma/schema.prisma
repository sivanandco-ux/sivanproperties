// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  AGENT
}

enum ListingType {
  RENT
  SALE
}

enum ListingStatus {
  ACTIVE
  RENTED
  SOLD
  WITHDRAWN
}

enum ProspectSource {
  PUBLIC_FORM
  MANUAL
}

enum PipelineStage {
  INQUIRY
  VIEWING_SCHEDULED
  VIEWED
  DISCUSSION
  OUTCOME_RENTED
  OUTCOME_SOLD
  OUTCOME_DROPPED
}

enum LeaseStatus {
  ACTIVE
  RENEWED
  EXPIRED
  VACATED
}

enum ProfessionalRole {
  CPA
  LAWYER
  PROPERTY_INSPECTOR
  PROPERTY_MANAGER
  POLICE_VERIFICATION_AGENT
  OTHER
}

enum TaskType {
  LEASE_DRAFTING
  LEASE_SIGNING
  TENANT_POLICE_VERIFICATION
  PROPERTY_INSPECTION
  RENT_COLLECTION
  TDS_FILING
  INDIA_TAX_FILING
  US_TAX_FILING
  PROPERTY_TAX_PAYMENT
  MAINTENANCE_PAYMENT
  LEASE_RENEWAL_DECISION
  VACATE_NOTICE
  OTHER
}

enum TaskRecurrence {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

model AllowedTester {
  email     String   @id
  note      String?
  createdAt DateTime @default(now())

  @@map("allowed_testers")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(OWNER)

  accounts Account[]
  sessions Session[]

  ownedProperties Property[]   @relation("OwnerProperties")
  assignments     Assignment[] @relation("AgentAssignments")
  pipelineEvents  PipelineEvent[] @relation("EventAuthor")

  createdAt DateTime @default(now())

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Property {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String        @db.Text
  listingType ListingType
  status      ListingStatus @default(ACTIVE)

  addressLine String
  city        String        @default("Chennai")
  state       String        @default("Tamil Nadu")
  pincode     String?

  priceInInr  Int?

  photos        Photo[]
  assignments   Assignment[]
  prospects     Prospect[]
  leases        Lease[]
  professionals Professional[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("properties")
}

model Photo {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  @@map("photos")
}

model Assignment {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId    String
  agent      User     @relation("AgentAssignments", fields: [agentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([propertyId, agentId])
  @@map("assignments")
}

model Prospect {
  id         String         @id @default(cuid())
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name       String
  contact    String
  notes      String?        @db.Text
  source     ProspectSource @default(PUBLIC_FORM)

  events     PipelineEvent[]
  leases     Lease[]

  createdAt  DateTime @default(now())

  @@map("prospects")
}

model PipelineEvent {
  id         String        @id @default(cuid())
  prospectId String
  prospect   Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  stage      PipelineStage
  notes      String?       @db.Text
  photoUrl   String?

  authorId   String
  author     User          @relation("EventAuthor", fields: [authorId], references: [id])

  createdAt  DateTime @default(now())

  @@map("pipeline_events")
}

model Professional {
  id         String           @id @default(cuid())
  propertyId String
  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name       String
  role       ProfessionalRole
  contact    String?
  licenseNumber String?
  notes      String?          @db.Text

  tasks      Task[]

  createdAt  DateTime @default(now())

  @@map("professionals")
}

model Lease {
  id         String      @id @default(cuid())
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  prospectId String?
  prospect   Prospect?   @relation(fields: [prospectId], references: [id])

  tenantName    String
  tenantContact String

  startDate DateTime
  endDate   DateTime

  rentInInr    Int
  depositInInr Int

  status LeaseStatus @default(ACTIVE)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leases")
}

model Task {
  id      String @id @default(cuid())
  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  type       TaskType
  title      String?
  recurrence TaskRecurrence @default(ONE_TIME)
  status     TaskStatus     @default(PENDING)

  dueDate DateTime

  assignedProfessionalId String?
  assignedProfessional   Professional? @relation(fields: [assignedProfessionalId], references: [id])

  completedDate    DateTime?
  completedByName  String?
  proofDocumentUrl String?
  notes            String?   @db.Text

  createdAt DateTime @default(now())

  @@map("tasks")
}
